    border-bottom: 1px solid var(--border);
    padding: 16px 0;
    font-size: 14px;
  }
  .dialog-meta { color: var(--muted-foreground); }
  .dialog-amount { white-space: nowrap; }
  .dialog-delete { margin-top: 20px; }
  .dialog-warn { margin-bottom: 16px; color: var(--destructive); }
  .dialog-text { margin-top: 8px; font-size: 14px; line-height: 24px; color: var(--muted-foreground); }
  .dialog-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 24px; }
  .dialog-btn {
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card) !important;
    color: var(--primary) !important;
    font-size: 13px;
    font-weight: 500;
    transition: background 0.15s;
  }
  .dialog-btn:hover { background: var(--secondary) !important; }
  .dialog-btn-danger {
    height: 44px;
    border-radius: 8px;
    background: var(--destructive) !important;
    color: oklch(0.96 0 0) !important;
    font-size: 13px;
    font-weight: 500;
    transition: filter 0.15s;
  }
  .dialog-btn-danger:hover { filter: brightness(1.1); }
  .dialog-btn-danger:disabled { opacity: 0.5; cursor: not-allowed; }
  
  /* ---------- responsivo ---------- */
  @media (max-width: 680px) {
    .account-container { width: calc(100% - 38px); }
    .metric-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px; }
    .metric { gap: 9px; padding: 7px 9px; }
    .metric-icon { width: 29px; height: 29px; }
    .metric-label { font-size: 11px; }
    .metric-value { font-size: 16px; }
    .trade-row { grid-template-columns: 30px minmax(64px, 1fr) minmax(92px, 1.2fr) 72px 10px; column-gap: 6px; }
    .trade-date { font-size: 10px; gap: 3px; }
    .trade-amount { font-size: 14px; }
    .status-content { flex-wrap: wrap; }
    .reprove-button { margin-left: auto; }
  }
  @media (max-width: 370px) {
    .trade-date svg, .date-separator { display: none; }
    .trade-row { grid-template-columns: 26px minmax(62px, 1fr) minmax(78px, 1.1fr) 64px 8px; column-gap: 4px; }
    .trade-amount { font-size: 13px; }
    .progress-dots { gap: 4px; }
    .progress-dots i { width: 7px; height: 7px; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }
</file>

<file path="src/screens/intelligence.css">
/* ============================================================
   PropControl — Aba "Inteligência" (CSS)
   Cores 100% via variáveis. Breakpoints: 680px e 370px.
   ============================================================ */

   .intel-screen {
    --bg: #0b0b0d;
    --surface: #0d0d10;
    --card: #111113;
    --hover: #1a1a1e;
    --text: #f5f5f5;
    --text-sec: #8a8a92;
    --border: #232329;
    --gold: #d4af37;
    --gold-ink: #1a1400;
    --positive: #34d399;
    --negative: #f87171;
    --info: #3b82f6;
    --violet: #a78bfa;
    --radius: 11px;
  
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    padding: 16px 12px 64px;
    -webkit-font-smoothing: antialiased;
  }
  .intel-wrap { max-width: 1180px; margin: 0 auto; }
  
  /* ---------- Cabeçalho ---------- */
  .intel-hero { padding: 8px 0 16px; }
  .intel-hero-top { display: flex; align-items: center; gap: 12px; }
  .intel-h1 { margin: 0; font-size: 22px; font-weight: 900; letter-spacing: 0.02em; }
  .intel-sub { margin: 2px 0 0; font-size: 11px; color: var(--text-sec); }
  .gold-title { color: var(--gold); text-shadow: 0 0 16px rgba(212, 175, 55, 0.2); }
  @media (min-width: 680px) {
    .intel-hero { padding: 12px 0 20px; }
    .intel-h1 { font-size: 30px; }
    .intel-sub { font-size: 14px; }
  }
  
  /* Botões de período — 3 lado a lado em qualquer largura >= 370px */
  .period-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 20px; }
  .period-button {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    height: 34px; padding: 0 8px; border-radius: 7px; cursor: pointer;
    border: 1px solid var(--border); background: var(--card);
    color: var(--text-sec); font-size: 11px; font-weight: 600; font-family: inherit;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .period-button:hover { border-color: rgba(212, 175, 55, 0.45); color: var(--gold); }
  .period-active {
    border-color: var(--gold); color: var(--gold);
    background: linear-gradient(180deg, rgba(212, 175, 55, 0.12), rgba(212, 175, 55, 0.05));
    box-shadow: 0 0 14px rgba(212, 175, 55, 0.18), inset 0 0 12px rgba(212, 175, 55, 0.06);
  }
  .period-icon { width: 13px; height: 13px; flex-shrink: 0; }
  
  /* ---------- Pilha de seções ---------- */
  .intel-stack { display: flex; flex-direction: column; gap: 10px; }
  
  /* Painel de card */
  .intel-panel {
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: var(--radius);
    background: linear-gradient(130deg, var(--card) 0%, var(--surface) 60%, var(--card) 100%);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.55);
  }
  .intel-section { padding: 12px; }
  @media (min-width: 680px) { .intel-section { padding: 16px; } }
  
  /* ---------- Estado vazio ---------- */
  .intel-empty { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 48px 24px; gap: 12px; }
  .empty-title { margin: 4px 0 0; font-size: 15px; font-weight: 800; color: var(--text); }
  .empty-text { margin: 0; max-width: 380px; font-size: 12px; line-height: 1.6; color: var(--text-sec); }
  
  /* ATIVOS · HORÁRIOS · CONTEXTOS — um do lado do outro (empilham < 370px) */
  .cards-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  @media (max-width: 369px) { .cards-row { grid-template-columns: 1fr; } }
  
  /* Cabeçalho de seção */
  .section-head { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 12px; }
  .section-title { margin: 0; font-size: 12px; line-height: 1rem; font-weight: 700; color: var(--gold); }
  .section-sub { margin: 2px 0 0; font-size: 11px; line-height: 1.5; color: var(--text-sec); }
  .columns-label { margin: 0 0 4px; padding-bottom: 8px; border-bottom: 1px solid var(--border); font-size: 9px; font-weight: 700; color: var(--text-sec); }
  .section-body { display: flex; flex-direction: column; }
  
  /* ---------- Ícones circulares (borda na própria cor + glow) ---------- */
  .icon-badge { display: flex; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 999px; }
  .icon-badge svg { width: 18px; height: 18px; }
  .icon-badge-primary { border: 1px solid rgba(212, 175, 55, 0.45); background: rgba(212, 175, 55, 0.1); color: var(--gold); box-shadow: 0 0 16px rgba(212, 175, 55, 0.13); }
  .icon-badge-positive { border: 1px solid rgba(52, 211, 153, 0.45); background: rgba(52, 211, 153, 0.1); color: var(--positive); box-shadow: 0 0 16px rgba(52, 211, 153, 0.13); }
  .icon-badge-info { border: 1px solid rgba(59, 130, 246, 0.45); background: rgba(59, 130, 246, 0.1); color: var(--info); box-shadow: 0 0 16px rgba(59, 130, 246, 0.13); }
  .icon-badge-violet { border: 1px solid rgba(167, 139, 250, 0.45); background: rgba(167, 139, 250, 0.1); color: var(--violet); box-shadow: 0 0 16px rgba(167, 139, 250, 0.13); }
  .icon-badge-sm { width: 32px; height: 32px; }
  .icon-badge-sm svg { width: 14px; height: 14px; }
  .icon-badge-hero {
    position: relative; width: 56px; height: 56px;
    border: 2px solid rgba(212, 175, 55, 0.9);
    background: linear-gradient(180deg, rgba(212, 175, 55, 0.06), rgba(212, 175, 55, 0.03));
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.22), inset 0 0 12px rgba(212, 175, 55, 0.09);
  }
  .icon-badge-hero::before { content: ""; position: absolute; inset: -4px; border-radius: 999px; border: 1px solid rgba(212, 175, 55, 0.2); pointer-events: none; }
  .icon-badge-hero svg { width: 28px; height: 28px; }
  @media (min-width: 680px) { .icon-badge-hero { width: 64px; height: 64px; } }
  
  /* ---------- Visão Geral ---------- */
  .overview-panel { padding: 16px; }
  @media (min-width: 680px) { .overview-panel { padding: 20px; } }
  .overview-head { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; color: var(--gold); }
  .metric-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: #2E2E38;
    border: 1px solid #2E2E38;
    border-radius: 9px;
    overflow: hidden;
  }
  .metric-cell { min-width: 0; padding: 12px; background: #131316; }
  .metric-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin: 0; font-size: 10px; font-weight: 700; text-transform: uppercase; color: var(--text-sec); }
  .metric-value-row { display: flex; align-items: center; gap: 10px; min-height: 24px; }
  .metric-value { margin: 4px 0 0; font-size: 17px; font-weight: 800; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .metric-value-sm { font-size: 14px; }
  .metric-chart { flex-shrink: 0; color: var(--gold); opacity: 0.75; }
  .metric-chart svg, .metric-chart { width: 20px !important; height: 20px !important; }
  .int-donut {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 999px;
    -webkit-mask: radial-gradient(circle, transparent 52%, #000 60%);
    mask: radial-gradient(circle, transparent 52%, #000 60%);
    animation: donut-glow 2.4s ease-in-out infinite;
  }
  @keyframes donut-glow {
    0%, 100% { filter: drop-shadow(0 0 3px rgba(212, 175, 55, 0.35)); }
    50% { filter: drop-shadow(0 0 9px rgba(212, 175, 55, 0.7)); }
  }
  .metric-pill { display: inline-flex; margin: 4px 0 0; padding: 2px 8px; border-radius: 4px; border: 1px solid rgba(52, 211, 153, 0.3); background: rgba(52, 211, 153, 0.1); color: var(--positive); font-size: 10px; }
  .metric-sub { margin: 4px 0 0; font-size: 10px; color: var(--text-sec); }
  .flame-icon { display: inline-block; vertical-align: middle; width: 18px !important; height: 18px !important; margin-right: 5px; color: var(--gold); }
  .secondary-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: #2E2E38;
    border: 1px solid #2E2E38;
    border-top: 0;
    border-radius: 0 0 9px 9px;
    overflow: hidden;
    margin-top: -1px;
  }
  .secondary-metrics > * { background: #131316; }
  .overview-note { display: flex; align-items: center; gap: 8px; margin: 0; padding: 12px 0 0; font-size: 11px; color: var(--text-sec); }
  .overview-note-icon { flex-shrink: 0; color: var(--gold); }
  @media (min-width: 680px) {
    .metric-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); border-radius: 9px 9px 0 0; }
    .metric-value { font-size: 20px; }
    .secondary-metrics { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 369px) {
    .metric-grid { grid-template-columns: 1fr; }
  }
  
  /* ---------- Linhas de ranking ---------- */
  .rank-row { display: flex; align-items: flex-start; gap: 10px; padding: 12px 2px; border-bottom: 1px solid var(--border); transition: background 0.2s ease; }
  .rank-row:hover { background: rgba(212, 175, 55, 0.04); }
  .rank-body { min-width: 0; flex: 1; }
  .rank-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px; }
  .rank-name { overflow-wrap: anywhere; font-size: 11px; font-weight: 700; }
  .rank-right { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
  .rank-meta { margin: 6px 0 0; font-size: 10px; color: var(--text-sec); }
  .rank-badge { display: flex; width: 28px; height: 28px; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 999px; border: 1px solid var(--border); background: var(--hover); color: var(--text-sec); font-size: 10px; font-weight: 900; }
  .rank-first { border-color: rgba(212, 175, 55, 0.45); background: rgba(212, 175, 55, 0.11); color: var(--gold); box-shadow: 0 0 12px rgba(212, 175, 55, 0.1); }
  .int-value { font-weight: 900; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .text-positive { color: var(--positive); }
  .text-negative { color: var(--negative); }
  
  .r-tag { flex-shrink: 0; padding: 2px 6px; border-radius: 999px; border: 1px solid; font-size: 10px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .positive-tag { border-color: rgba(52, 211, 153, 0.28); background: rgba(52, 211, 153, 0.08); color: var(--positive); }
  .negative-tag { border-color: rgba(248, 113, 113, 0.28); background: rgba(248, 113, 113, 0.08); color: var(--negative); }
  
  /* ---------- Barra central zero ---------- */
  .bar-wrap { position: relative; margin-top: 8px; padding-bottom: 10px; }
  .bar-track { position: relative; height: 6px; overflow: hidden; border-radius: 999px; background: var(--hover); }
  .bar-tick { position: absolute; top: 0; bottom: 0; left: 50%; width: 1px; background: var(--text-sec); }
  .bar-fill { position: absolute; top: 0; bottom: 0; }
  .bar-fill-positive { left: 50%; border-radius: 0 999px 999px 0; background: var(--positive); }
  .bar-fill-negative { right: 50%; border-radius: 999px 0 0 999px; background: var(--negative); }
  .bar-zero { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); font-size: 9px; line-height: 1; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--text-sec); }
  
  /* ---------- Timeframes ---------- */
  .tf-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  @media (min-width: 680px) { .tf-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .tf-cell { display: block; text-align: center; }
  .tf-name { margin: 0; font-size: 13px; font-weight: 900; color: var(--gold); }
  .tf-value { margin-top: 6px; font-size: 13px; }
  .tf-r { margin: 2px 0 0; font-size: 10px; font-weight: 700; }
  
  /* ---------- Leitura do Operacional ---------- */
  .highlight-grid { display: grid; grid-template-columns: 1fr; gap: 8px; }
  @media (min-width: 680px) { .highlight-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .int-highlight { padding: 16px; border-radius: 8px; border: 1px solid var(--border); background: linear-gradient(130deg, var(--surface), var(--card)); }
  .highlight-best { border-color: rgba(52, 211, 153, 0.3); }
  .highlight-worst { border-color: rgba(248, 113, 113, 0.35); }
  .highlight-head { display: flex; align-items: center; gap: 12px; }
  .highlight-icon { display: flex; width: 36px; height: 36px; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 999px; border: 1px solid; }
  .hl-positive { border-color: rgba(52, 211, 153, 0.3); background: rgba(52, 211, 153, 0.1); color: var(--positive); }
  .hl-negative { border-color: rgba(248, 113, 113, 0.3); background: rgba(248, 113, 113, 0.1); color: var(--negative); }
  .hl-neutral { border-color: var(--border); background: rgba(255, 255, 255, 0.04); color: var(--text-sec); }
  .highlight-name { margin: 4px 0 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14px; font-weight: 900; }
  .highlight-stats { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 8px; margin-top: 12px; }
  .highlight-total { font-size: 18px; }
  .highlight-warn { margin: 8px 0 0; font-size: 10px; font-weight: 600; color: var(--negative); }
  .highlight-note { margin: 8px 0 0; font-size: 10px; color: var(--text-sec); }
  
  /* ---------- Combinações / Conclusão / Rodapé ---------- */
  .combos-empty { margin: 0; padding: 20px; border: 1px dashed var(--border); border-radius: 8px; text-align: center; font-size: 11px; color: var(--text-sec); }
  .conclusion-card { display: flex; align-items: center; gap: 16px; padding: 16px; background: linear-gradient(110deg, rgba(212, 175, 55, 0.05), var(--card) 60%, rgba(11, 11, 13, 0.96)); }
  .conclusion-body { min-width: 0; flex: 1; }
  .conclusion-text { margin: 6px 0 0; font-size: 11px; line-height: 1.6; color: var(--text-sec); }
  .conclusion-brain { display: none; color: var(--gold); opacity: 0.8; flex-shrink: 0; }
  @media (min-width: 680px) { .conclusion-brain { display: block; } .conclusion-text { font-size: 14px; } }
  .foot-note { display: flex; align-items: flex-start; gap: 8px; padding: 12px 16px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--card); font-size: 11px; line-height: 1.6; color: var(--text-sec); }
  .foot-icon { margin-top: 2px; flex-shrink: 0; color: var(--gold); }
  
  /* ---------- Botão "ver todos" ---------- */
  .more-button {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    width: 100%; height: 36px; margin-top: 12px; padding: 0 12px; cursor: pointer;
    border: 1px solid var(--border); border-radius: 7px; background: rgba(11, 11, 13, 0.5);
    color: var(--text); font-size: 11px; font-weight: 600; font-family: inherit;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .more-button:hover { border-color: rgba(212, 175, 55, 0.3); color: var(--gold); }
</file>

