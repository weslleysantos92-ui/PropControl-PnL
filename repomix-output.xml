{phase:1,name:'Phase 1',rules:{targetPct:10,drawdownType:'Estático',maxDrawdownBySize:{'10K':1200,'25K':3000,'50K':6000,'100K':12000},dailyLossBySize:{'10K':400,'25K':1000,'50K':2000,'100K':4000},profitableDaysEnabled:true,profitableDays:3,profitableDayPct:0.5}},
{phase:2,name:'Phase 2',rules:{targetPct:6,drawdownType:'Estático',maxDrawdownBySize:{'10K':1200,'25K':3000,'50K':6000,'100K':12000},dailyLossBySize:{'10K':400,'25K':1000,'50K':2000,'100K':4000},profitableDaysEnabled:true,profitableDays:3,profitableDayPct:0.5}}
]}]}
];
export function hydrateRules(rules:PhaseRules,size:AccountSize):PhaseRules{const capital={'10K':10000,'25K':25000,'50K':50000,'100K':100000,'150K':150000}[size];const targetPct=rules.targetPctBySize?.[size]??rules.targetPct;const maxDrawdown=rules.maxDrawdownBySize?.[size]??rules.maxDrawdown;const dailyLoss=rules.dailyLossBySize?.[size]??rules.dailyLoss;return{...rules,targetPct,target:rules.target??(targetPct!=null?capital*targetPct/100:undefined),maxDrawdown,dailyLoss};}
