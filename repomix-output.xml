  }
  .account-shell h1, .account-shell h2, .account-shell p { margin: 0; }
  .account-shell button {
    font: inherit;
    color: inherit;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .numeric { font-variant-numeric: tabular-nums; }
  
  .account-container { width: min(100% - 38px, 1180px); margin-inline: auto; }
  .account-topbar {
    height: 42px;
    background: transparent;
  }
  .topbar-inner { display: flex; align-items: center; height: 100%; }
  .account-content { padding-top: 0; padding-bottom: 25px; }
  
  /* ---------- cards ---------- */
  .account-panel {
    border: 1px solid color-mix(in oklch, var(--primary) 19%, var(--border));
    border-radius: 11px;
    background: linear-gradient(130deg, var(--surface), color-mix(in oklch, var(--surface), var(--background) 22%));
    margin-top: 9px;
  }
  .section-heading {
    color: var(--primary);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
  }
  
  /* ---------- card 1: identidade ---------- */
  .account-identity { display: flex; align-items: center; gap: 15px; min-height: 70px; padding: 8px 12px; margin-top: 0; }
  .identity-mark {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border: 1px solid var(--primary);
    border-radius: 50%;
    color: var(--primary);
    box-shadow: 0 0 17px color-mix(in oklch, var(--primary) 25%, transparent);
  }
  .identity-mark-icon { position: absolute; }
  .identity-text { min-width: 0; flex: 1; }
  .identity-title-row { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }
  .identity-name { font-size: 17px; font-weight: 600; line-height: 22px; }
  .identity-sub { margin-top: 4px; font-size: 12.5px; color: var(--muted-foreground); }
  .account-code { margin-top: 3px; color: var(--muted-foreground); font-size: 11.5px; letter-spacing: 0.05em; }
  .account-code span { color: var(--primary); font-weight: 500; }
  .phase-pill {
    border: 1px solid color-mix(in oklch, var(--primary) 34%, transparent);
    border-radius: 99px;
    padding: 3px 11px;
    background: color-mix(in oklch, var(--primary) 11%, transparent);
    color: var(--primary);
    font-size: 11px;
    font-weight: 600;
    line-height: 16px;
  }
  
  /* ---------- card 2: margem de risco ---------- */
  .risk-panel { padding: 13px 16px 14px; }
  .risk-axis { position: relative; margin: 60px 6px 0; }
  .risk-bubble {
    position: absolute;
    bottom: calc(100% + 14px);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    transform: translateX(-50%);
    transition: left 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .risk-bubble-label { color: var(--muted-foreground); font-size: 11.5px; letter-spacing: 0.02em; }
  .risk-bubble-value {
    position: relative;
    display: inline-block;
    padding: 6px 18px 7px;
    border: 1px solid #35353d;
    border-radius: 10px;
    background: linear-gradient(180deg, #1c1c20, #111113);
    font-size: 17px;
    font-weight: 800;
    line-height: 1;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.07);
  }
  .risk-bubble-value.amount-take { color: var(--positive); text-shadow: 0 0 12px color-mix(in oklch, var(--positive) 55%, transparent), 0 0 28px color-mix(in oklch, var(--positive) 30%, transparent); }
  .risk-bubble-value.amount-stop { color: var(--negative); text-shadow: 0 0 12px color-mix(in oklch, var(--negative) 55%, transparent), 0 0 28px color-mix(in oklch, var(--negative) 30%, transparent); }
  .risk-bubble-pointer {
    position: absolute;
    top: 100%;
    left: 50%;
