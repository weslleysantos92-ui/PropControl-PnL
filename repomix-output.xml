  .pc-dashboard > div:first-child .flex.items-center.gap-4 > .flex-1.min-w-0 h2 { font-size: 21px !important; line-height: 1.12 !important; }
  .pc-dashboard > div:first-child .flex.items-center.gap-4 > .flex-shrink-0.w-11.h-11 { width: 38px !important; height: 38px !important; }
  .pc-dashboard > div:first-child .flex.items-center.gap-3 > .flex-shrink-0 svg { width: 21px !important; height: 21px !important; }
  .pc-dashboard > div:first-child .flex.items-center.gap-3 > .flex-shrink-0 + .flex-shrink-0 + .flex-1 { min-width: 0 !important; }
  .pc-dashboard > div:first-child .flex.items-center.gap-3 > .flex.flex-col.items-end { min-width: 78px; max-width: 86px; }
