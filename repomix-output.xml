type Tab = 'dashboard'|'calendario'|'mesas'|'jornada'|'financas'|'analise';
const TABS = [{id:'dashboard' as Tab,label:'Início',icon:Home},{id:'calendario' as Tab,label:'Calendário',icon:CalendarDays},{id:'mesas' as Tab,label:'Mesas',icon:Building2},{id:'analise' as Tab,label:'Inteligência',icon:Brain},{id:'financas' as Tab,label:'Financeiro',icon:Banknote},{id:'jornada' as Tab,label:'Jornada',icon:Footprints}];

const css=`.pc-shell{min-height:100vh;background:#0B0B0D;color:#eee}.pc-sidebar{display:none}.pc-content{min-height:100vh}.pc-header{height:70px;border-bottom:1px solid #24242B;background:#0B0B0D}.pc-header-inner{height:100%;display:flex;align-items:center;justify-content:space-between;padding:0 20px}.pc-main{max-width:1180px;margin:0 auto;padding:20px 16px 90px}.pc-mobile-nav{display:block}.pc-journey{width:100%}
/* Todas as telas internas usam o mesmo fundo estrutural do app. Os cards continuam com seus tons escuros próprios. */
.pc-account-detail > div:first-child,.pc-calendar,.pc-intelligence > div:first-child,.pc-journey > div:first-child,.pc-mesas > section:first-child{background:#0B0B0D!important}
@media(min-width:900px){.pc-sidebar{display:flex;position:fixed;inset:0 auto 0 0;width:220px;z-index:50;flex-direction:column;padding:24px 16px;background:#0E0E11;border-right:1px solid #24242B}.pc-content{margin-left:220px}.pc-header{height:68px}.pc-header-inner{padding:0 24px;max-width:none;margin:0}.pc-main{max-width:1180px;margin:0 auto;padding:24px 24px 50px}.pc-main>.pc-dashboard,.pc-main>.pc-calendar,.pc-main>.pc-journey,.pc-main>.pc-account-detail,.pc-main>.pc-intelligence,.pc-main>section,.pc-main>div:not(.pc-trade-modal){max-width:1140px;margin-left:auto;margin-right:auto}.pc-dashboard{max-width:1140px!important;margin:0 auto!important}.pc-dashboard>div:first-child,.pc-dashboard>section{max-width:1140px;margin-left:auto;margin-right:auto}
/* Desktop density: compact, left-aligned and intentionally leaves breathing room on wide screens. */
.pc-calendar{padding-top:8px!important;padding-left:0!important;padding-right:0!important}.pc-calendar>.mx-auto{max-width:1140px!important;margin-left:auto!important;margin-right:auto!important}.pc-calendar section{padding:18px!important}.pc-calendar section:first-of-type{padding:18px!important}.pc-calendar .mb-6{margin-bottom:14px!important}.pc-calendar .grid.grid-cols-7{gap:5px!important}.pc-calendar .grid.grid-cols-7>button{border-radius:10px!important}.pc-calendar .pc-calendar-summary>div{min-height:76px!important;padding:10px!important}
.pc-journey{max-width:1140px!important;margin:0 auto!important}
