/* Desktop density: compact, left-aligned and intentionally leaves breathing room on wide screens. */
.pc-calendar{padding-top:8px!important;padding-left:0!important;padding-right:0!important}.pc-calendar>.mx-auto{max-width:820px!important;margin-left:0!important;margin-right:0!important}.pc-calendar section{padding:18px!important}.pc-calendar section:first-of-type{padding:18px!important}.pc-calendar .mb-6{margin-bottom:14px!important}.pc-calendar .grid.grid-cols-7{gap:5px!important}.pc-calendar .grid.grid-cols-7>button{border-radius:10px!important}.pc-calendar .pc-calendar-summary>div{min-height:76px!important;padding:10px!important}
.pc-journey{max-width:820px!important;margin:0!important}
