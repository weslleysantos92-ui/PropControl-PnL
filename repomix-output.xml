}

function EmptyState({ text }: { text: string }) {
  return <div className="rounded-xl p-5 text-center" style={{ background: '#17171C', border: '1px dashed #2A2A31' }}><p className="text-xs" style={{ color: '#9CA3AF' }}>{text}</p></div>;
}
