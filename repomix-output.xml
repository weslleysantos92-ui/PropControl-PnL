.finances-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 20px; border: 1px dashed #1a2438; border-radius: 16px; background: rgba(10,16,32,.5); }

/* Finances modal styles */
.finances-modal-label { display: block; font-size: 11px; font-weight: 600; color: #6b8499; margin-bottom: 8px; text-transform: uppercase; letter-spacing: .06em; }
.finances-modal-input { width: 100%; padding: 12px 16px; border-radius: 12px; background: #0a1020; border: 1px solid #1a2438; color: #fff; font-size: 14px; outline: none; transition: border-color .2s; }
.finances-modal-input:focus { border-color: rgba(52,211,153,.4); }
.finances-modal-input::placeholder { color: #3a4a60; }
.finances-modal-empty { border: 1px dashed #1a2438; border-radius: 12px; background: rgba(10,16,32,.5); padding: 14px; font-size: 12px; color: #6b8499; }
.finances-account-pill { border: 1px solid #1a2438; border-radius: 10px; padding: 8px 14px; font-size: 12px; font-weight: 700; color: #6b8499; background: rgba(10,16,32,.5); transition: all .2s; cursor: pointer; }
.finances-account-pill.pill-active { border-color: rgba(52,211,153,.5); background: rgba(52,211,153,.1); color: #34d399; }
.finances-modal-calc { border: 1px solid rgba(52,211,153,.2); background: rgba(52,211,153,.06); border-radius: 12px; padding: 12px 16px; font-size: 12px; color: #94a3b8; }
