    --muted-foreground: #8A8A92;
    --primary: #D4AF37;                          /* dourado */
    --primary-foreground: #1A1400;
    --destructive: #F87171;
    --border: #232329;
    --positive: #34D399;
    --negative: #F87171;
    --info: #3B82F6;
  }
  
  /* ---------- base ---------- */
  .account-shell {
    min-height: 100vh;
    background: var(--background);
