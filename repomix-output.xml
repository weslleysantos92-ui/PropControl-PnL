/* ============================================================
   AccountDetail — folha de estilos completa (Diário de Trades)
   Importe uma vez, dentro de src/screens/AccountDetail.tsx.
   Paleta alinhada ao restante do PropControl: preto neutro (sem
   tom de azul) + dourado de destaque + verde/azul/vermelho de status.
   fundo #0B0B0D · card #111113 · dourado #D4AF37 · verde #34D399
   vermelho #F87171 · azul #3B82F6 · borda #232329 · texto #F5F5F5
   ============================================================ */

   :root {
    --radius: 0.5rem;
    --background: #0B0B0D;
    --foreground: #F5F5F5;
    --card: #111113;
    --surface: #0D0D10;
    --secondary: #1A1A1E;
