ange={e=>updatePhase(i,{profitableDayPct:Number(e.target.value)})}/></Field></div>}<Toggle label="Exige colchão" value={!!phase.rules.cushionEnabled} onChange={v=>updatePhase(i,{cushionEnabled:v})}/>{phase.rules.cushionEnabled&&<Field label="Valor do colchão ($)"><input type="number" className="input" value={phase.rules.cushion??''} onChange={e=>updatePhase(i,{cushion:Number(e.target.value)})}/></Field>}</div>)}{saveError&&<p className="rounded-xl border border-red-500/30 bg-red-500/10 px-3 py-2.5 text-xs text-red-300">{saveError}</p>}<button disabled={busy||!name.trim()||!program.trim()||!sizes.length||!phasesValid} onClick={save} className="w-full rounded-2xl bg-[#D4AF37] py-3.5 font-black text-[#0B0B0D] disabled:opacity-40">{busy?'Salvando...':'Salvar mesa'}</button></div></div></div>}</section>}
function Field({label,children}:{label:string;children:ReactNode}){return <label className="block"><span className="mb-1.5 block text-[10px] font-bold uppercase tracking-wider text-gray-600">{label}</span>{children}</label>}
