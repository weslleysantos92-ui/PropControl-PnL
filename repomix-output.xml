import { ArrowLeft, Trash2, AlertTriangle, TrendingUp, Shield, CalendarDays, Wallet, Gauge, CircleDollarSign, Crown, Check } from 'lucide-react';
import { useState } from 'react';
import { useApp } from '@/store';
