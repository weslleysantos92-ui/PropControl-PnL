    height: 11px;
    transform: translateX(-50%) rotate(45deg);
    border-right: 1px solid #35353d;
    border-bottom: 1px solid #35353d;
    background: #111113;
  }
  .risk-track { position: relative; }
  .risk-glow {
    position: absolute;
    top: -4px;
    bottom: -4px;
    border-radius: 999px;
    filter: blur(10px);
    opacity: 0.55;
    pointer-events: none;
    animation: risk-neon 2.6s ease-in-out infinite;
  }
  .glow-red { left: -2px; width: 52%; background: linear-gradient(90deg, transparent, oklch(0.55 0.22 27)); }
  .glow-blue { right: -2px; width: 46%; background: linear-gradient(270deg, oklch(0.2 0.06 260), oklch(0.55 0.2 255)); }
  .risk-line {
    position: relative;
    z-index: 1;
    height: 14px;
    overflow: hidden;
    border: 1px solid oklch(0.32 0.02 255 / 0.9);
    border-radius: 999px;
    background:
      repeating-linear-gradient(90deg, transparent 0 7px, oklch(0.06 0.01 255 / 0.65) 7px 9px),
      linear-gradient(90deg, oklch(0.2 0.06 25) 0%, oklch(0.4 0.16 27) 34%, oklch(0.56 0.23 27) 49.6%, oklch(0.56 0.21 256) 50.4%, oklch(0.48 0.17 258) 72%, oklch(0.26 0.09 262) 100%);
    box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.22), inset 0 -2px 4px oklch(0 0 0 / 0.45);
  }
  .risk-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, oklch(1 0 0 / 0.28) 50%, transparent 70%);
    transform: translateX(-100%);
    animation: risk-shine 3.2s ease-in-out 1s infinite;
  }
  .risk-cursor {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 15px;
    height: 15px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, oklch(0.95 0.07 92), oklch(0.78 0.13 84) 60%, oklch(0.62 0.11 78));
    box-shadow: 0 0 6px oklch(0.85 0.12 88 / 0.9), 0 0 18px 4px oklch(0.75 0.13 84 / 0.55), 0 0 0 3px oklch(0.1 0.01 255 / 0.8);
    animation: risk-glow 2.4s ease-in-out infinite;
    transition: left 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .risk-reflection {
    display: block;
    height: 11px;
    margin: 5px 2px 0;
    border-radius: 999px;
    opacity: 0.45;
    filter: blur(1.5px);
    background: linear-gradient(90deg, oklch(0.2 0.06 25) 0%, oklch(0.4 0.16 27) 34%, oklch(0.56 0.23 27) 49.6%, oklch(0.56 0.21 256) 50.4%, oklch(0.48 0.17 258) 72%, oklch(0.26 0.09 262) 100%);
    -webkit-mask-image: linear-gradient(to bottom, black, transparent 80%);
    mask-image: linear-gradient(to bottom, black, transparent 80%);
  }
  @keyframes risk-neon { 0%, 100% { opacity: 0.45; } 50% { opacity: 0.8; } }
  @keyframes risk-shine { 0% { transform: translateX(-100%); } 55%, 100% { transform: translateX(230%); } }
  @keyframes risk-glow {
    0%, 100% { box-shadow: 0 0 6px oklch(0.85 0.12 88 / 0.9), 0 0 18px 4px oklch(0.75 0.13 84 / 0.55), 0 0 0 3px oklch(0.1 0.01 255 / 0.8); }
    50% { box-shadow: 0 0 8px oklch(0.9 0.12 90 / 1), 0 0 26px 7px oklch(0.75 0.13 84 / 0.7), 0 0 0 3px oklch(0.1 0.01 255 / 0.8); }
  }
  .risk-labels { display: flex; justify-content: space-between; margin-top: 10px; color: var(--primary); font-size: 12px; font-weight: 600; }
  .risk-remaining { display: flex; gap: 10px; margin-top: 14px; }
